# The site is generated by build.sh; this only decides when to rerun it and
# gives the checks and the local preview a name.
OUT = build

# Everything the generated site is built out of. articles/ is listed whole
# because the media in there is published alongside the pages, so a new
# screenshot has to reach build/ the same way a new paragraph does.
SOURCES = build.sh projects-index articles-index \
	  template/index.html template/article.html template/feed.rss \
	  $(wildcard static/*) $(wildcard articles/*) $(wildcard *.css)

.PHONY: all html check serve clean

all: html

html: $(OUT)/index.html

$(OUT)/index.html: $(SOURCES)
	sh build.sh

# What CI runs. Catches an unexpanded placeholder and a link to something that
# is not in the build, which is the failure a static site actually has.
check: html
	sh ci/check.sh

# Preview the built site the way it is served: paths like /favicon-32x32.png are
# absolute, so opening build/index.html straight off the filesystem does not
# show the real thing.
serve: html
	cd $(OUT) && python3 -m http.server 8000

clean:
	rm -rf $(OUT)
